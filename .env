NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/task_tracker?schema=public
# Required in production; generate e.g. with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
WEB_ORIGIN=http://localhost:5173